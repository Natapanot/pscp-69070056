"""Impostor"""
def main():
    """Impostor"""
    crew = {}
    body = {}
    while True:
        word = input()
        if word == "Start":
            break
        word = word.strip("{}\"")
        color,status = word.split("\" : \"")
        crew[color] = status
    while True:
        word = input()
        if word == "End":
            break
        if word in crew:
            body[word] = crew[word]
            crew.pop(word)
    count = 0
    for _,i in crew.items():
        if i == "Impostor":
            count += 1
    print(count,"Impostor Remains")
    print("***Alive***")
    for k, v in sorted(crew.items(), key=lambda item: item[0]):
        print(k,":",v)
    print("***Dead***")
    for k, v in sorted(body.items(), key=lambda item: item[0]):
        print(k,":",v)
main()
