"""[LEARNING LOGS] หั่นขนมปัง"""
def main():
    """Kanompang"""
    w,h,m,n = map(int,input().split())
    XM = list(map(int,input().split()))
    YN = list(map(int,input().split()))
    X=[]
    Y=[]

    for i in range(m+1):
        if not i:
            X.append(XM[i])
        elif i == m:
            X.append(w-XM[i-1])
        else:
            X.append(XM[i]-XM[i-1])

    for i in range(n+1):
        if not i:
            Y.append(YN[i])
        elif i == n:
            Y.append(h-YN[i-1])
        else:
            Y.append(YN[i]-YN[i-1])

    total =[]
    for i in range(m+1):
        for j in range(n+1):
            total.append(X[i]*Y[j])
    mass1 = max(total)
    total.pop(total.index(mass1))
    mass2 = max(total)
    print(mass1,mass2)
main()
