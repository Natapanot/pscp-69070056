"""[LEARNING LOGS] Pad Thai"""
def main():
    """ผัดใคร"""
    ingrediant = ["Pad Thai Sauce","Tofu","Pickle Turnip","Shrimp","Bean Sprouts",
                "Noodle","Chives","Lime","Egg","Oil","Peanuts"]

    checkin = ["Pad Thai Sauce","Tofu","Pickle Turnip","Shrimp","Bean Sprouts",
                "Noodle","Chives","Lime","Egg","Oil","Peanuts"]

    taste = ["Sweet","Sour","Salty"]
    check = ["Sweet","Sour","Salty"]
    tIn = False
    temptaste = False

    while True:
        word = input()
        if word == "Cook":
            break
        if word in ingrediant and word in checkin:
            checkin.remove(word)
        elif word not in ingrediant:
            checkin.append(word)
            tIn = True

    while True:
        word = input()
        if word == "End":
            break
        if word in taste and word in check:
            check.remove(word)
        elif word not in taste:
            check.append(word)
            temptaste = True

    if not checkin and not check:
        print("Delicious!")
    elif not checkin and (temptaste or check):
        print("Not Bad...")
    elif tIn:
        print("This is not Pad Thai!!!")
    else:
        print("This is bad!")
main()
